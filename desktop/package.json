{
  "name": "local-coder-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local Coder agent workspace",
  "author": "Local Coder contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "dev.localcoder.desktop",
    "productName": "Local Coder",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "sidecar.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "backend",
        "filter": [
          "local-coder-engine",
          "local-coder-engine.exe"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
